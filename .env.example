# ==============================================================================
# Database Configuration
# ==============================================================================

# --- Option A: Supabase PostgreSQL (Production / Cloud) ---
# In Supabase: Project Settings -> Database -> Connection string -> URI / JDBC
# Use Session pooler (Port 5432) or Direct Connection with sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# --- Option B: Local Docker PostgreSQL (Development) ---
# POSTGRES_DB=revyze
# POSTGRES_USER=revyze
# POSTGRES_PASSWORD=revyzepassword
# POSTGRES_PORT=5432
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/revyze
# SPRING_DATASOURCE_USERNAME=revyze
# SPRING_DATASOURCE_PASSWORD=revyzepassword

# ==============================================================================
# Application Configuration
# ==============================================================================
PORT=8080

# ==============================================================================
# Security Configuration
# ==============================================================================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# CORS Configuration
# ==============================================================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# ==============================================================================
# File Storage
# ==============================================================================
APP_STORAGE_UPLOAD_DIR=./uploads/materials
